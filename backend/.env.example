# Database
DATABASE_URL=postgresql://verisub_user:verisub_password@localhost:5432/verisub_db
DATABASE_URL_TEST=sqlite:///./test.db

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=VERISUB
APP_VERSION=1.0.0
DEBUG=true

# SMTP (optional - leave empty for dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
