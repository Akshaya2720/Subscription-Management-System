# Database
DATABASE_URL=sqlite:///./verisub.db

# Blockchain Anchoring (Free Sepolia PublicNode)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_NETWORK=sepolia

# Generative AI (Free Google AI Studio)
GEMINI_API_KEY=your_gemini_key

# Transactional Email (Free Brevo or Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_smtp_key
SMTP_FROM_EMAIL=billing@verisub.com

# Telemetry (Free UptimeRobot)
UPTIMEROBOT_API_KEY=your_uptimerobot_key
